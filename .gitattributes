# Normalize line endings in the repository.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf

# Windows scripts keep CRLF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Gradle POSIX launcher must stay LF.
gradlew text eol=lf

# Binaries
*.jar binary
*.so binary
*.apk binary
*.aab binary
